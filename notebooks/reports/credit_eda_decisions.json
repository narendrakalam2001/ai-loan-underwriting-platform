{
  "dataset": "GiveMeSomeCredit/cs-training.csv",
  "split": {
    "train_rows": 119512,
    "holdout_rows": 29879,
    "test_size": 0.2,
    "stratify": "default",
    "random_state": 42
  },
  "base_default_rate_train": 0.067,
  "column_rename_map": {
    "SeriousDlqin2yrs": "default",
    "RevolvingUtilizationOfUnsecuredLines": "revolving_util",
