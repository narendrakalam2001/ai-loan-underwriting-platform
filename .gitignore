# ============================================================
# .gitignore — AI Loan Underwriting Platform
# Rule of thumb: push everything needed to DEPLOY and to REPRODUCE
# (code, tests, docs, sample data, the champion models); keep out
# secrets, big raw datasets, caches and experiment clutter.
# ============================================================

# ── Secrets (NEVER commit) ───────────────────────────────────
.env
.env.*
!.env.example
*.key
secrets.toml
.streamlit/secrets.toml

# ── Python / tooling caches ──────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# ── Virtual environments ─────────────────────────────────────
venv/
.venv/
env/
capstone_env/

# ── IDE / OS ─────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ── Experiment tracking (large; regenerated by training) ─────
mlruns/
mlartifacts/

# ── Real datasets: too big for GitHub (100 MB/file limit) and
#    not ours to redistribute. Download from Kaggle instead. ───
cs-training.csv
cs-test.csv
creditcard.csv
*.zip
*.rar
*.7z
# The small stand-in CSVs in data/raw/ ARE pushed (sample data).

# ── Runtime-generated data ───────────────────────────────────
data/document_cache/*
!data/document_cache/.gitkeep
data/processed/*
!data/processed/.gitkeep
# the built TF-IDF index is rebuilt on deploy by scripts/ingest_knowledge_base.py
data/knowledge_base/_index.joblib

# ── Logs: audit trail is per-decision runtime data ───────────
# (to ship a few demo decisions for the dashboard, run the simulator and
#  `git add -f logs/audit_trail/<files>` — synthetic applicants only)
logs/audit_trail/*
!logs/audit_trail/.gitkeep
logs/*.log
*.log

# ── Models: keep ONLY the production champions ───────────────
# Every retrain writes a new timestamped .joblib. The API needs just the
# champion that models/<engine>/latest_model.json points to, so everything
# else stays local. The small registry/card/monitoring files ARE pushed
# (the ops dashboard reads them).
#
# >>> After a retrain + PROMOTED: add the new champion filename below,
# >>> and delete the old one. (`git add -f <file>` also works.)
models/**/*.joblib
!models/credit_risk/credit_model_XGBoost_20261015_164445.joblib
!models/fraud/fraud_model_XGBoost_20261015_121938.joblib
models/**/*.pkl
models/**/*.png

# ── Local-only working notes / zips ──────────────────────────
HANDOFF_PROMPT.md
pytest_output.txt
*.tmp