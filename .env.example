# Copy to .env for local use. NEVER commit the real .env (it is git-ignored).
# Optional: without a key the API uses its offline template / rules fallbacks.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Portal / simulator -> where the API runs (no trailing slash)
UNDERWRITING_API_URL=http://localhost:8000
# Optional: Devanagari .ttf for Hindi decision-letter PDFs
HINDI_FONT_PATH=
# Optional: skip models that crash on your machine during training
# EXCLUDE_MODELS=LightGBM,KNN
